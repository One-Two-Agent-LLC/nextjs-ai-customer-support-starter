{
  "name": "nextjs-ai-customer-support-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/prepare-config.mjs && next dev",
    "build": "node scripts/prepare-config.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:setup": "node --env-file=.env.local db/setup.mjs",
    "demo:cleanup": "node --env-file=.env.local scripts/cleanup-demo.mjs",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "doctor": "onetwoagent doctor"
  },
  "dependencies": {
    "@onetwoagent/integration": "0.1.1",
    "next": "16.3.8",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@onetwoagent/cli": "0.4.3",
    "@playwright/test": "1.58.2",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.21.0",
    "typescript": "7.0.2"
  }
}
